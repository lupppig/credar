# Runtime identity
CREDAR_ENVIRONMENT=local
CREDAR_LOG_LEVEL=debug
CREDAR_HTTP_ADDRESS=:8080
CREDAR_HTTP_SHUTDOWN_TIMEOUT_SECONDS=10
CREDAR_READINESS_TIMEOUT_SECONDS=2

# Authoritative and asynchronous infrastructure
CREDAR_DATABASE_URL=postgres://credar:credar_local@postgres:5432/credar?sslmode=disable
CREDAR_DATABASE_MAX_CONNECTIONS=10
CREDAR_DATABASE_MIN_CONNECTIONS=1
CREDAR_NATS_URL=nats://nats:4222
CREDAR_OUTBOX_POLL_MILLISECONDS=250
CREDAR_OUTBOX_LEASE_SECONDS=30
CREDAR_OUTBOX_BATCH_SIZE=100
CREDAR_OUTBOX_MAX_ATTEMPTS=8
CREDAR_OUTBOX_BASE_BACKOFF_SECONDS=1
CREDAR_OUTBOX_MAX_BACKOFF_SECONDS=300
CREDAR_REDIS_URL=redis://redis:6379/0
CREDAR_REDIS_KEY_PREFIX=credar

# Optional host ports used by Docker Compose. Container-to-container addresses
# remain the stable service names above.
CREDAR_POSTGRES_HOST_PORT=5432
CREDAR_NATS_HOST_PORT=4222
CREDAR_NATS_MONITOR_HOST_PORT=8222
CREDAR_REDIS_HOST_PORT=6379
CREDAR_SEAWEEDFS_HOST_PORT=8333
CREDAR_KRATOS_PUBLIC_HOST_PORT=4433
CREDAR_KRATOS_ADMIN_HOST_PORT=4434
CREDAR_BACKEND_HOST_PORT=8080
CREDAR_FRONTEND_HOST_PORT=3000

# Object storage
CREDAR_OBJECT_STORAGE_ENDPOINT=http://seaweedfs:8333
CREDAR_OBJECT_STORAGE_BUCKET=credar-local
CREDAR_OBJECT_STORAGE_ACCESS_KEY=local-access-key
CREDAR_OBJECT_STORAGE_SECRET_KEY=local-secret-key

# Authentication integration
CREDAR_KRATOS_PUBLIC_URL=http://kratos:4433
CREDAR_KRATOS_ADMIN_URL=http://kratos:4434
CREDAR_KRATOS_REQUEST_TIMEOUT_SECONDS=2
CREDAR_KRATOS_SESSION_LIFESPAN=24h

# Frontend. NEXT_PUBLIC values are embedded into browser-visible output.
NEXT_PUBLIC_CREDAR_API_BASE_URL=http://localhost:8080
CREDAR_BACKEND_INTERNAL_URL=http://backend:8080
